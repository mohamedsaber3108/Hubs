NODE_ENV=test
PORT=3001

# SQLite for tests (no MySQL needed)
DB_DIALECT=sqlite
DB_STORAGE=:memory:

JWT_ACCESS_SECRET=test_access_secret_at_least_32_chars_long_abc
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_chars_long_abc
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ADMIN_JWT_SECRET=test_admin_secret_at_least_32_chars_long_abc

# NOTE: 6380, not the default 6379 -- this dev machine already has an
# unrelated project's Redis container bound to 6379. Our Docker Compose
# dev stack (docker-compose.dev.yml) maps usamhub-dev-redis to 6380 to
# avoid colliding with it. See docs/DEV_ENVIRONMENT_SETUP.md.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=test-bucket
AWS_SES_FROM=noreply@test.com

ANTHROPIC_API_KEY=test_key

LOG_LEVEL=error
