# ══════════════════════════════════════════════
# USAM Hub Backend — Environment Variables
# ══════════════════════════════════════════════

# Server
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
LOG_LEVEL=info

# Database (RDS)
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=usam_hub
DB_USER=usam_user
DB_PASSWORD=your_strong_password_here
DB_NAME_TEST=usam_hub_test

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OAuth — Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/v1/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://yourdomain.com/api/v1/auth/github/callback

# OAuth — Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://yourdomain.com/api/v1/auth/facebook/callback

# OAuth — LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=https://yourdomain.com/api/v1/auth/linkedin/callback

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=usam-hub-storage
AWS_S3_BUCKET_PRIVATE=usam-hub-private
AWS_SES_FROM=noreply@yourdomain.com
AWS_SES_REPLY_TO=support@yourdomain.com

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# NomadAI Chatbot
ANTHROPIC_API_KEY=your_anthropic_api_key_here
